# API URL used by the Vite/React frontend.
# Local dev:
VITE_API_BASE_URL=http://127.0.0.1:8000

# Staging example:
# VITE_API_BASE_URL=https://api.example.com

# Auth mode.
# dev keeps the app in local/demo mode.
# cognito enables Cognito Hosted UI sign-in through react-oidc-context.
VITE_AUTH_MODE=dev

# Required when VITE_AUTH_MODE=cognito.
VITE_COGNITO_REGION=us-east-2
VITE_COGNITO_USER_POOL_ID=us-east-2_SV9to18Q1
VITE_COGNITO_APP_CLIENT_ID=e0p7dlk90s9bnbtqi4jvhi18i
