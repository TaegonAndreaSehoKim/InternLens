# InternLens API staging settings
#
# Comma-separated frontend origins allowed to call the API.
# For local dev, keep the localhost defaults. For staging, set this to the
# Amplify/S3/CloudFront URL, for example:
# INTERNLENS_CORS_ORIGINS=https://main.example.amplifyapp.com
INTERNLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default corpus path used when API callers omit jobs_dir.
# Relative paths are resolved from the repository root; absolute paths are allowed.
INTERNLENS_JOBS_DIR=data/processed/jobs

# SQLite database path for stored profiles, feedback, recommendation runs, and job actions.
# For a single-server staging deploy, point this at a persistent volume/path if available.
INTERNLENS_DB_PATH=data/app/internlens.db
